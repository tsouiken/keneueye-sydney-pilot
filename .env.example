# ===== KenEyeCue 測驗 MVP 環境變數 =====

# 伺服器埠號（Railway 會自動給 PORT，本機測試用 3000）
PORT=3000

# 資料持久化目錄（Railway volume 掛載點；未設定＝存在專案根目錄，重啟即丟）
# DATA_DIR=/data

# 部署後的外部網址（ECPay 回傳與付款完成跳轉用）
# 例如：https://keneyecue-quiz.up.railway.app
BASE_URL=http://localhost:3000

# ===== ECPay 綠界（留空 = 模擬付款模式，可完整測試流程）=====
# 申請綠界商戶後填入，三個都要填才會啟用真實付款
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# CheckMacValue 演算法：sha256（新商戶預設）或 md5（舊商戶）
ECPAY_HASH_ALG=sha256
# 付款方式：Credit（只有信用卡，預設）／ATM（只有虛擬帳號）／ALL（信用卡＋ATM＋超商代收）
# 設成 ATM 或 ALL 前，需先在綠界後台「收款設定」開通對應付款方式
ECPAY_CHOOSE_PAYMENT=Credit

# ===== Make 自動化（留空 = 不發送）=====
# 在 Make 建立一個「自訂 Webhook」情境，把網址填進來：
# 訂單成立 → order.created
# 付款成功 → order.paid（附 method: Credit/ATM/DEMO）
# ATM 取號 → order.atm_pending（附虛擬帳號）
MAKE_WEBHOOK_URL=

# ---------- 結果式付費：交報告用 ----------
# Ken 透過 POST /api/admin/report 交報告時要帶 x-admin-token 標頭。
# 留空 = 該端點關閉（回 503），沒有人交得了報告，案件會停在 submitted。
ADMIN_TOKEN=

# 同一個聯絡方式最多能有幾件「還沒付款」的案件同時在跑。
# 結果式付費的人工分析發生在收錢之前，這是跑單成本的上限。預設 2。
MAX_OPEN_PER_CONTACT=2
